# NOVA – Secrets & API-Config Vorlage
# Kopiere diese Datei nach .env und trage echte Werte ein.
# .env ist in .gitignore und wird NIE committed.

# --- Telegram ---
# Bot-Token: @BotFather in Telegram -> bestehenden Bot wählen oder neuen erzeugen
TELEGRAM_TOKEN=<BOT_TOKEN_VON_BOTFATHER>
# Public-Channel für Signale, z.B. @dein_kanal (Bot muss dort Admin sein)
TELEGRAM_CHANNEL_ID=<PUBLIC_CHANNEL_ID>
# Public-Channel für KI-News, z.B. @dein_ki_kanal (Bot muss dort Admin sein)
TELEGRAM_KI_NEWS_CHANNEL_ID=<PUBLIC_CHANNEL_ID>
# Telegram-User-ID des Admins (z.B. via @userinfobot ermitteln)
TELEGRAM_ADMIN_ID=<TELEGRAM_USER_ID_DES_ADMINS>

# --- Gotify ---
# Gotify-Server im lokalen Netz, z.B. http://gotify.example.org:8070
GOTIFY_URL=<GOTIFY_SERVER_URL>
# Neues Token auf dem Gotify-Server unter der App anlegen
GOTIFY_TOKEN=<GOTIFY_APP_TOKEN>
GOTIFY_APP_NAME=<GOTIFY_APP_NAME>

# --- Brave Search API ---
# Key beziehen unter https://brave.com/search/api/
BRAVE_SEARCH_KEY=<BRAVE_SEARCH_API_KEY>
